#!/bin/bash
# omarchy-macos-shortcuts: after `omarchy update`, warn (via a desktop
# notification) if Omarchy's new defaults collide with the macOS shortcuts or
# the config block was removed. Installed by install.sh; removed by
# `install.sh uninstall`.

check="@REPO_DIR@/bin/omarchy-macos-check"
[[ -x $check ]] && "$check" --notify
exit 0
